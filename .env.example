# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/vaarsamen?sslmode=require

# ─── NextAuth / Auth.js ──────────────────────────────────────────────────────
AUTH_SECRET=<genereer met: openssl rand -base64 32>
NEXTAUTH_URL=https://jouwapp.vercel.app

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Resend (e-mail magic link) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@vaarsamen.nl

# ─── Pusher (realtime berichten) ─────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ─── Vercel Blob (foto uploads) ──────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Stripe (premium abonnementen) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Web Push notificaties ───────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:info@vaarsamen.nl

# ─── OpenRouter (AI voortgangsanalyse) ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Model ID zoals op openrouter.ai/models (standaard: anthropic/claude-opus-4.5)
OPENROUTER_MODEL=anthropic/claude-opus-4.5

# ─── Demo accounts (optioneel) ────────────────────────────────────────────────
# ALLOW_DEMO_USERS=true  →  twee demo-knoppen op /school/login:
#   • Petra Smit (Instructeur)    instructeur.demo@vaarsamen.nl
#   • Lisa van der Berg (Cursist) lisa.demo@vaarsamen.nl
# Seed uitvoeren via: POST /api/admin/demo/seed (vereist isAdmin)
# In development (zonder ALLOW_DEMO_USERS): log direct in via dev-login met een van bovenstaande e-mails.
ALLOW_DEMO_USERS=true

# Legacy: single demo user (vervangen door ALLOW_DEMO_USERS, maar nog ondersteund)
# DEMO_EMAIL=eigenaar.demo@vaarsamen.nl
# DEMO_USER_ID=aadde100-0000-0000-0000-000000000002
